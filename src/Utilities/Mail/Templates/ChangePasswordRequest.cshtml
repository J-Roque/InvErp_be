@model Mail.Models.ChangePasswordRequestModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Solicitud de Cambio de Contraseña</title>
</head>
<body style="margin:0; padding:20px; background-color:#f4f4f4; font-family: Arial, sans-serif; text-align:center;">
<table width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr>
        <td align="center">
            <table width="600" cellspacing="0" cellpadding="20" border="0"
                   style="background-color:#ffffff; text-align:left;">

                <!-- Encabezado -->
                <tr>
                    <td align="center" bgcolor="#0b198f"
                        style="padding:30px; color:#ffffff; font-size:24px; font-weight:bold; font-family: Arial, sans-serif;">
                        <img src="https://www.bureauveritas.com.pe/wp-content/uploads/2021/05/logo.svg"
                             alt="Bureau Veritas" style="display:block; margin-bottom:10px;">
                        <div style="margin-top:10px;">Homologaciones</div>
                    </td>
                </tr>

                <!-- Asunto -->
                <tr>
                    <td align="center"
                        style="padding:20px; color:#0b198f; font-size:18px; font-weight:bold; font-family: Arial, sans-serif;">
                        Solicitud de Cambio de Contraseña
                    </td>
                </tr>

                <!-- Contenido -->
                <tr>
                    <td style="padding:30px; color:#333333; font-size:14px; font-family: Arial, sans-serif;">
                        Estimado/a <strong>@Model.Username</strong>,<br><br>
                        Hemos recibido una solicitud para cambiar la contraseña de su cuenta. La solicitud se realizó el
                        <strong>@Model.RequestDate</strong>. Si usted no solicitó este cambio, puede ignorar este correo
                        de manera segura.<br><br>
                        Si desea proceder con el cambio de contraseña, haga clic en el siguiente botón:
                        <br><br>
                        <div style="text-align: center;">
                            <a href="@Model.ResetUrl"
                               style="background-color:#0b198f; color:#ffffff; padding:12px 20px; text-decoration:none; font-size:16px; font-weight:bold; border-radius:5px; display:inline-block;">Cambiar
                                Contraseña</a>
                        </div>
                        <br>
                        Si tiene alguna pregunta o necesita asistencia, no dude en contactarnos.
                    </td>
                </tr>

                <!-- Información de contacto -->
                <tr>
                    <td style="padding:30px; color:#333333; font-size:12px; line-height:1.5; font-family: Arial, sans-serif;">
                        <strong>BUREAU VERITAS | Perú</strong><br>
                        Av. Santa Cruz 888, Oficina 601, Miraflores. Lima, Perú<br>
                        <a href="http://www.bureauveritas.com.pe" style="color:#0b198f; text-decoration:none;">http://www.bureauveritas.com.pe</a><br>
                        <a href="mailto:notificacionesperu@bureauveritas.com"
                           style="color:#0b198f; text-decoration:none;">notificacionesperu@bureauveritas.com</a>
                    </td>
                </tr>

                <!-- Pie de página -->
                <tr>
                    <td align="center" bgcolor="#0b198f"
                        style="padding:30px; color:#ffffff; font-size:14px; font-weight:bold; font-family: Arial, sans-serif;">
                        #Construyendo un mundo de confianza
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
